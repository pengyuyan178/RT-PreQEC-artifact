# Project outputs
results/*
!results/logs/
!results/logs/.gitkeep
!results/figures/
!results/figures/.gitkeep
!results/tables/
!results/tables/.gitkeep
!results/runs/
!results/runs/.gitkeep
# Run outputs are regenerated by the evaluation scripts and can reach ~800MB.
# The `!results/runs/` line above only un-ignores the directory itself so the
# .gitkeep survives; re-ignore its contents so a reviewer's rerun is not staged.
results/runs/*
!results/runs/.gitkeep
# Re-rendered figure/table outputs from the reproduction commands are regenerable;
# ignore those rerun dirs but keep the committed reference figures/tables tracked.
results/figures/rerun/
results/figures/rerun_test/
checkpoints/*
!checkpoints/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.npz
*.pt
*.pth
*.csv
*.png
*.pdf

# --- Artifact repository: reproduction inputs and reference outputs ---
# These override the blanket *.npz / *.pt / *.csv / *.png rules above so the
# artifact is self-contained: a reviewer can evaluate without rebuilding the
# 300k-sample dataset or retraining, and can diff a rerun against the
# published figures and tables.
!data/processed/predecoder_dataset_v1_300k.npz
!data/processed/predecoder_dataset_v1_300k_splits.json
!checkpoints/**/*.pt
!checkpoints/**/*.csv
!checkpoints/**/*.json
!results/figures/**/*.png
!results/tables/*.csv

# The paper's own figures, and the data behind every figure and table in it.
# Without these negations the blanket *.pdf / *.csv rules above would silently
# drop the whole of figure/ and table/ -- see section 9 of README.md for the
# mapping from each file to the paper element it feeds.
!figure/*.pdf
!figure/*.png
!table/**/*.csv

# PNG renderings of the paper figures, embedded in README.md so the walkthrough
# displays inline on the repository landing page. Generated from figure/*.pdf
# with `pdftoppm -png -r 160`; regenerate with the command in README.md.
!docs/assets/*.png
